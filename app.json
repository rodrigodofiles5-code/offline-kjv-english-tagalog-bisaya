{
  "expo": {
    "name": "KJV Bible EN TL CEB Offline",
    "slug": "kjv-bible-en-tl-ceb-offline",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kjvbible.offline.entlceb",
      "infoPlist": {
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "com.kjvbible.offline.entlceb",
      "permissions": [],
      "blockedPermissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-splash-screen",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "notifications": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
